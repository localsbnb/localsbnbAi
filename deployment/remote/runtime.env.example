# 专用远程配置示例；复制到受保护文件后填写，不能复用根目录 .env。
# 不填写 APP_SECRET/APP_ID/LOCALSBNB_CREDENTIALS_PATH 等本地账号配置。
LOCALSBNB_REMOTE_ENV=dev
LOCALSBNB_REMOTE_PUBLIC_ORIGIN=https://mcp.example.com
LUKEYUN_API_BASE_URL=https://hudson-dev.localhome.cn
LOCALSBNB_SITE_URL=https://overseas-dev.localhome.cn
LOCALSBNB_REMOTE_PORT=8787
LOCALSBNB_REMOTE_DATABASE_URL=postgresql://localsbnb_mcp:REPLACE_PASSWORD@127.0.0.1:55432/localsbnb_mcp
LOCALSBNB_REMOTE_REDIS_URL=redis://:REPLACE_PASSWORD@127.0.0.1:56379
LOCALSBNB_REMOTE_ACTIVE_KEY_ID=k1
# 32 字节随机密钥的 64 位小写 hex；保留旧 key 才能解密原有记录。
LOCALSBNB_REMOTE_KEYS_JSON='{"k1":"REPLACE_WITH_RANDOM_64_HEX"}'
# client 和回调必须替换为实际平台注册数据。
LOCALSBNB_REMOTE_CLIENTS_JSON='[{"clientId":"REPLACE_CLIENT_ID","authMethod":"none","redirectUris":["https://client.example.com/callback"],"allowedScopes":["rooms:read"]}]'
# 默认关闭业务；启用前应用 001 + 002，并配置 PC 服务间兑换密钥。
LOCALSBNB_REMOTE_BUSINESS_ENABLED=0
LOCALSBNB_REMOTE_HANDSHAKE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX
# 原生进程默认 loopback；Docker overlay 明确覆盖为容器内 0.0.0.0。
LOCALSBNB_REMOTE_BIND_HOST=127.0.0.1
