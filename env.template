# Lukeyun API
LUKEYUN_API_BASE_URL=https://api.lukeyun.com

# Hudson auth (new APIs)
# Replace with your actual values
HUDSON_ACCESS_TOKEN=your-hudson-access-token-here
CAMP_ID=your-camp-id-here

# Server
NODE_ENV=development
LOG_LEVEL=info

# Logging
LOG_FORMAT=json
# Write logs/combined.log and logs/error.log under the project dir (default off; stderr only, avoids polluting dirs when run via npx globally)
# LOCALSBNB_LOG_TO_FILES=1

# Cache (optional)
CACHE_ENABLED=true
CACHE_TTL=300000

# Retries (optional)
MAX_RETRIES=3
RETRY_DELAY=1000
